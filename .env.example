# No external service or credentials are needed for the basic startup.
LLM_MODEL=dummy

# Set LLM_MODEL=gemini and install requirements-gemini.txt to use Gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=
GEMINI_REQUEST_TIMEOUT=30
GEMINI_RETRIES=1

# Set LLM_MODEL=ollama and install requirements-ollama.txt to use Ollama.
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.7

# Set LLM_MODEL=transformers, install requirements-transformers.txt,
# and provide a model identifier.
# TRANSFORMERS_MODEL=

# Database: sqlite by default; install requirements-postgres.txt for postgres.
DB_OPTION=sqlite
SQLITE_DB_PATH=sqlite.db
JOB_UPLOAD_DIR=data/uploads
# DB_NAME=semantic_search_db
# DB_USER=vector_admin
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5433
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=8

# Embedding model and vector index must match; a change requires reindexing.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# PDF chunking and optional OCR.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
OCR_ENABLED=false
OCR_LANG=eng

LOG_LEVEL=INFO

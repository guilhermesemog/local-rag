# Available LLM providers are 'gemini' and 'ollama'
LLM_MODEL=gemini

# Optional if you want to use Gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT=30
GEMINI_RETRIES=1

# Optional if you want to use Ollama
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.7

# Optional if you want to use a Hugging Face Transformers model
# Set LLM_MODEL=transformers and configure the model id below
TRANSFORMERS_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Database option: 'sqlite' or 'postgres' - if you choose 'postgres', make sure to run the container
DB_OPTION=sqlite

# Path to the SQLite database file (only needed if DB_OPTION is 'sqlite')
SQLITE_DB_PATH=sqlite.db

# PDF parsing (defaults preserve the existing chunk size and overlap)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Optional OCR for scanned pages; requires requirements-ocr.txt and Tesseract.
OCR_ENABLED=false
OCR_LANG=eng
